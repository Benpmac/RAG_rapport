# RAG_3 ANSTAT-CI — variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs

# Répertoire racine du projet (monté dans Docker)
RAG3_DIR=/opt/rag3/data

# Chemin vers le modèle BGE-M3 (téléchargé par scripts/download_model.sh)
EMBEDDING_MODEL=/opt/rag3/models/bge-m3

# Taille de batch pour l'encodage (réduire si OOM)
BATCH_SIZE=16

# Répertoire cache HuggingFace
HF_HOME=/opt/rag3/models/hf_cache

# UID/GID pour les fichiers créés par Airflow (évite les problèmes de permissions)
AIRFLOW_UID=50000

# Clé secrète Airflow (générez avec : python -c "import secrets; print(secrets.token_hex(32))")
AIRFLOW__CORE__FERNET_KEY=

# URL vLLM pour l'enrichissement contextuel RAPTOR (laisser vide pour désactiver)
# Configurez aussi via Airflow UI : Admin > Variables > rag3_vllm_url
VLLM_URL=
